# APP
APP_PORT=4000
APP_ENV=development
APP_NAME=rancho-api-dev
# Zona horaria del negocio: el día de la semana de cada noche (entre semana /
# fin de semana) se calcula SIEMPRE en esta zona, nunca en UTC (CONTEXT §3.2).
APP_TIMEZONE=America/Bogota
# URL pública de este backend: con ella se arman las URLs de las fotos subidas.
APP_BASE_URL=http://localhost:4000
APP_FRONTEND_URL=http://localhost:3000
# true solo detrás de un proxy (nginx / Dokploy) para que el rate limit del
# login vea la IP real del visitante y no la del proxy.
APP_TRUST_PROXY=false

# CORS
# Orígenes permitidos, separados por coma (el navegador manda Origin).
APP_CORS_ORIGIN=http://localhost:3000

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rancho
DB_PASSWORD=cambia-esta-clave
DB_DATABASE=rancho_dev
DB_SSL=false

# JWT
# Solo para el panel admin. Generar cada secreto (mínimo 32 caracteres) con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# El refresh token rota en cada uso; el anterior queda invalidado.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# SWAGGER
# Documentación en /api/docs. Con usuario y clave se protege con Basic Auth;
# vacíos = abierta (solo recomendable en local).
SWAGGER_ENABLED=true
SWAGGER_USER=
SWAGGER_PASSWORD=

# UPLOADS
# local = carpeta UPLOADS_DIR servida en /uploads. La interfaz StorageService
# permite cambiar a S3 / Cloudinary más adelante sin tocar los módulos.
# Producción (Dokploy): UPLOADS_DIR=/app/uploads, montado como volumen
# persistente (p. ej. /var/lib/dokploy/rancho-storage → /app/uploads); sin el
# volumen, cada despliegue borra las fotos.
UPLOADS_DRIVER=local
UPLOADS_DIR=./uploads
# Máximo por archivo (MB). 15 cubre una foto de celular (3–8 MB) o de cámara;
# sharp la reduce a ≤ 1920 px en WebP de todas formas. Una foto por petición.
UPLOADS_MAX_MB=15

# SEED
# Admin inicial que crea `pnpm run seed` (solo si ese correo no existe aún).
# En producción: SEED_SAMPLE_DATA=false → solo admin, ajustes y festivos (sin
# cabañas ni productos de ejemplo). Se ejecuta una vez: pnpm run seed:prod
SEED_SAMPLE_DATA=true
SEED_ADMIN_EMAIL=admin@ranchoporvenir.co
SEED_ADMIN_PASSWORD=
